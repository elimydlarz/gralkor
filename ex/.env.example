# Required for the functional tier (test/functional/) and the real-Pythonx
# integration tier (any test exercising GraphitiPool's shared LLM/embedder/
# cross_encoder construction or graphiti operations like search/add_episode).
#
# Without this credential, those tests surface graphiti's auth error
# unwrapped — there is no pre-flight gate.
#
# Get a key at https://aistudio.google.com/apikey, then copy this file
# to .env (gitignored) and fill it in.
GOOGLE_API_KEY=

# Optional — only required for the remote-FalkorDB functional test
# (test/functional/remote_falkordb_journey_test.exs). Skipped when unset.
#
# Spin up a local FalkorDB and point these at it:
#   docker run -d --name gralkor-falkordb-test -p 6380:6379 falkordb/falkordb:latest
#   FALKORDB_TEST_HOST=localhost FALKORDB_TEST_PORT=6380 mix test test/functional/remote_falkordb_journey_test.exs --include functional
#
# USERNAME/PASSWORD are optional — leave blank for an unauthenticated FalkorDB.
FALKORDB_TEST_HOST=
FALKORDB_TEST_PORT=
FALKORDB_TEST_USERNAME=
FALKORDB_TEST_PASSWORD=
